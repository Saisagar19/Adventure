@model List<Employee>

<h2>Employee List Data</h2>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>EmployeeId</th>
            <th>EmployeeName</th>
            <th>EmployeeDesignation</th>
            <th>EmployeeSalary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.EmpId</td>
                <td>@emp.EmpName</td>
                <td>@emp.Designation</td>
                <td>@emp.Salary</td>
            </tr>
        }
    </tbody>
</table>