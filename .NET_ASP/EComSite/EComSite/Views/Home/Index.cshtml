@model IEnumerable<EComSite.Models.Product>
@{
    ViewData["Title"] = "Home Page";
    int count = 0;
}
<h3>@Context.Session.Id</h3>
<div id="mainSlider" class="carousel slide mb-5" data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="~/images/A.jpg" class="d-block w-100" alt="Slide 1">
            <div class="carousel-caption bg-dark bg-opacity-50 rounded p-3">
                <h1>Welcome to MyWebsite</h1>
                <p>Explore the latest gadgets and electronics.</p>
                <a href="#" class="btn btn-primary">Shop Now</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/B.jpg" class="d-block w-100" alt="Slide 2">
            <div class="carousel-caption bg-dark bg-opacity-50 rounded p-3">
                <h1>High Quality Products</h1>
                <p>Top brands at affordable prices.</p>
                <a href="#" class="btn btn-primary">Explore</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/C.jpg" class="d-block w-100" alt="Slide 3">
            <div class="carousel-caption bg-dark bg-opacity-50 rounded p-3">
                <h1>Fast Delivery</h1>
                <p>Safe and secure shipping.</p>
                <a href="#" class="btn btn-primary">Learn More</a>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>

<div class="container my-5">
    <h2 class="text-center mb-4">Featured Products</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow h-100">
                <img src="~/images/lenovo.jpg" class="card-img-top" alt="Laptop">
                <div class="card-body">
                    <h5 class="card-title">Gaming Laptop</h5>
                    <p class="card-text">
                        Powerful gaming laptop with high-end graphics and performance.
                    </p>
                    <h4 class="text-primary">₹89,999</h4>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <img src="~/images/samsung.jpg" class="card-img-top" alt="Samsung">
                <div class="card-body">
                    <h5 class="card-title">Samsung Galaxy S26</h5>
                    <p class="card-text">
                        Samsung Galaxy S26 5G (Black, 12GB RAM, 256GB Storage)
                    </p>
                    <h4 class="text-primary">₹79,999</h4>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <img src="~/images/controller.jpg" class="card-img-top" alt="Controllers">
                <div class="card-body">
                    <h5 class="card-title">Gaming Controllers</h5>
                    <p class="card-text">
                        Premium quality.
                    </p>
                    <h4 class="text-primary">₹8,999</h4>
                    <a href="#" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>

        @foreach (var products in Model)
        {
            count++;
            if(count == 4)
            {
                break;
            }
            <div class="col-md-4">
                <div class="card shadow h-100">
                    <img src="@Url.Content(products.Picture)" class="card-img-top" alt="@products.ProductName">
                    <div class="card-body">
                        <h5 class="card-title">@products.ProductName</h5>
                        <p class="card-text">
                            @products.Description
                        </p>
                        <h4 class="text-primary">@products.UnitPrice.ToString("C")</h4>
                        <a class="btn btn-primary" asp-controller="Products" asp-action="Details" asp-route-id="@products.ProductId">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
