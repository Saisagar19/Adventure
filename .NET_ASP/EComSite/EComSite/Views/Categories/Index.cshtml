@model List<Category>

@{
    ViewData["PageTitile"] = "Categories From Index";
}

<h2>@ViewData["Title"]</h2>

<table class=" table table-striped table-hover">

    <thead>
        <tr>
            <th>Category Name</th>
            <th>Description</th>
            <th>Show Products</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Category cat in Model)
        {
            <tr>
                <td>@cat.CategoryName</td>
                <td>@cat.CategoryDesc</td>
                <td> <a class="btn btn-primary" asp-controller="Products" asp-action="CatWiseProducts" asp-route-categoryId="@cat.CategoryId">Show Products</a></td>
            </tr>
        }
    </tbody>
</table>